{
  "name": "@ohah/hwpjs-adapter",
  "version": "0.1.0",
  "description": "TableSchema adapter and anomaly detection for @ohah/hwpjs",
  "type": "module",
  "exports": {
    "./table-schema": {
      "types": "./src/table-schema.ts",
      "default": "./src/table-schema.ts"
    },
    "./anomaly": {
      "types": "./src/anomaly/index.ts",
      "default": "./src/anomaly/index.ts"
    },
    "./to-table": {
      "types": "./src/to-table.ts",
      "default": "./src/to-table.ts"
    },
    "./collection": {
      "types": "./src/collection/index.ts",
      "default": "./src/collection/index.ts"
    },
    "./extract": {
      "types": "./src/extract/index.ts",
      "default": "./src/extract/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "default": "./src/utils/index.ts"
    }
  },
  "dependencies": {
    "@ohah/hwpjs": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0"
  }
}
